load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_foreign_cc//foreign_cc:configure.bzl", "configure_make")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
)

configure_make(
    name = "tpm2_tss_impl",
    lib_source = ":all_srcs",
    autogen = True,
    autogen_command = "bootstrap",
    configure_in_place = True,
    configure_options = [
        "--enable-esys",
        "--enable-static",
        "--enable-nodl",
        "--enable-tcti-device",
        "--enable-tcti-mssim",
        "--enable-tcti-swtpm",
        "--disable-shared",
        "--disable-fapi",
        "--disable-fapi-async-tests",
        "--disable-integration",
        "--disable-weakcrypto",
    ],
    env = {
        # Provide search paths for host libraries (e.g., OpenSSL / libcrypto.pc).
        # We join standard paths rather than using platform select() because:
        # 1. Path variations depend on Linux distro (Debian multiarch vs. Fedora
        #    lib64) which Bazel CPU platform constraints cannot distinguish.
        # 2. pkg-config silently ignores nonexistent directories without error.
        "PKG_CONFIG_PATH": ":".join([
            "/usr/lib/x86_64-linux-gnu/pkgconfig",
            "/usr/lib/aarch64-linux-gnu/pkgconfig",
            "/usr/lib64/pkgconfig",
            "/usr/lib/pkgconfig",
            "/usr/share/pkgconfig",
        ]),
    },
    out_data_dirs = [
        "lib/pkgconfig",
    ],
    out_static_libs = [
        "libtss2-policy.a",
        "libtss2-esys.a",
        "libtss2-sys.a",
        "libtss2-tctildr.a",
        "libtss2-tcti-cmd.a",
        "libtss2-tcti-device.a",
        "libtss2-tcti-i2c-ftdi.a",
        "libtss2-tcti-i2c-helper.a",
        "libtss2-tcti-libtpms.a",
        "libtss2-tcti-mssim.a",
        "libtss2-tcti-pcap.a",
        "libtss2-tcti-spidev.a",
        "libtss2-tcti-spi-ftdi.a",
        "libtss2-tcti-spi-helper.a",
        "libtss2-tcti-spi-ltt2go.a",
        "libtss2-tcti-swtpm.a",
        "libtss2-mu.a",
        "libtss2-rc.a",
    ],
)

cc_library(
    name = "tpm2_tss",
    deps = [":tpm2_tss_impl"],
    linkopts = ["-lcrypto"],
)

filegroup(
    name = "gen_dir",
    srcs = [":tpm2_tss_impl"],
    output_group = "gen_dir",
)

